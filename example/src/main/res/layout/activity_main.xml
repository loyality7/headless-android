<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fetch Engine Headless Demo Hub"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a feature suite below to test live offscreen engine components:"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnOpenScrapeRead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Scrape, Input &amp; Live Screenshots"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnOpenScreenshotStudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Offscreen Screenshot Studio"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnOpenStorageInspector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Storage &amp; Cookie Inspector"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnOpenTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Telemetry &amp; Process Health"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

</LinearLayout>
