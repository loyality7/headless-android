<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scrape &amp; Read" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screenshots" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cookies &amp; Storage" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telemetry &amp; Health" />

    </com.google.android.material.tabs.TabLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- TAB 1: SCRAPE & READ -->
        <ScrollView
            android:id="@+id/layoutScrapeTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Offscreen Scraping &amp; Reading"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnScrapeHackerNews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HackerNews" />

                    <Button
                        android:id="@+id/btnScrapeWikipedia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Wikipedia" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnTestFormSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test HTML Form Submission Site"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvScrapeResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:text="Select a target site above to execute PlatformNavigator &amp; PlatformReader..."
                    android:textSize="14sp" />

            </LinearLayout>

        </ScrollView>

        <!-- TAB 2: SCREENSHOTS -->
        <ScrollView
            android:id="@+id/layoutScreenshotTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Offscreen Screenshot Studio"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnCaptureScreenshot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Capture Offscreen Bitmap (HackerNews)"
                    android:layout_marginBottom="12dp" />

                <ImageView
                    android:id="@+id/ivScreenshotPreview"
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:scaleType="fitCenter"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvScreenshotStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Click above to capture offscreen page layout bitmap..."
                    android:textSize="13sp" />

            </LinearLayout>

        </ScrollView>

        <!-- TAB 3: COOKIES & STORAGE -->
        <ScrollView
            android:id="@+id/layoutStorageTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Storage &amp; Cookie Engine Inspector"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnFetchCookies"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fetch Cookies" />

                    <Button
                        android:id="@+id/btnClearStorage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Clear Storage" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStorageResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:text="Inspect or manage process-global cookies and web storage..."
                    android:textSize="14sp" />

            </LinearLayout>

        </ScrollView>

        <!-- TAB 4: TELEMETRY & HEALTH -->
        <ScrollView
            android:id="@+id/layoutTelemetryTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SessionMetrics &amp; Telemetry Dashboard"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnRefreshTelemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run Telemetry Probe Session"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvTelemetryDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#212121"
                    android:textColor="#00FF66"
                    android:padding="16dp"
                    android:fontFamily="monospace"
                    android:text="Click above to run session telemetry diagnostic..."
                    android:textSize="13sp" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</LinearLayout>
